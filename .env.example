# Vapi private API key from dashboard.vapi.ai → Organization → API Keys
VAPI_API_KEY=

# Groq API key from console.groq.com (BYO credential on the Vapi assistant)
GROQ_API_KEY=

# Random secret Vapi sends to /api/vapi/webhook
# Generate with: openssl rand -hex 32
VAPI_WEBHOOK_SECRET=

# Optional. Defaults to data/clinic.sqlite
DATABASE_PATH=

# Public HTTPS origin used when provisioning the assistant webhook
PUBLIC_API_URL=

# Optional fallbacks if data/live.json is not present
NEXT_PUBLIC_INTAKE_PHONE=
VAPI_ASSISTANT_ID=
